# Copy to repository .env. Generate three DIFFERENT random values using the command in the guide.
# POSTGRES_PASSWORD must contain only letters, numbers, hyphen, underscore (URL-safe).
POSTGRES_PASSWORD=REPLACE_WITH_64_RANDOM_HEX
POSTGRES_DB=agilecampus
AUTH_SECRET=REPLACE_WITH_ANOTHER_64_RANDOM_HEX
CRON_SECRET=REPLACE_WITH_THIRD_64_RANDOM_HEX
DATABASE_URL=postgres://agilecampus:REPLACE_WITH_64_RANDOM_HEX@db:5432/agilecampus
AGILECAMPUS_URL=https://YOUR_DOMAIN
AUTH_URL=https://YOUR_DOMAIN
AUTH_TRUST_HOST=true
DOMAIN=YOUR_DOMAIN
APP_PORT=3080
# For the purchased 2-GiB server: true; build images on another Linux machine/CI.
SMALL_SERVER=false
# For public IPv4 HTTPS, use https://YOUR_IP above, DOMAIN=YOUR_IP, and this file:
# CADDYFILE=./deploy/Caddyfile.ip
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://YOUR_DOMAIN/api/auth/feishu/callback
FEISHU_BASE_URL=https://open.feishu.cn
